<idea-plugin>
    <id>com.example.notes</id>
    <name>Notes</name>
    <version>1.0.0</version>
    <vendor email="support@example.com" url="https://example.com">Example</vendor>

    <description><![CDATA[
        <h2>Notes</h2>
        <p>Create, manage, and organize notes directly inside the IDE.</p>
        <ul>
            <li>Create, edit, and auto-save notes that persist across IDE sessions.</li>
            <li>Dedicated Notes tool window with a searchable, sortable list.</li>
            <li>Custom titles, per-note background colors, pin and favorite.</li>
            <li>Quick previous/next navigation with keyboard shortcuts.</li>
            <li>Delete with confirmation (including bulk delete).</li>
            <li>Import and export notes as JSON or Markdown.</li>
        </ul>
    ]]></description>

    <!-- Minimum platform capabilities. -->
    <idea-version since-build="241"/>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionPoint="true" defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.example.notes.service.NotesService"/>
        <toolWindow id="Notes"
                    anchor="right"
                    icon="AllIcons.Toolwindows.Notifications"
                    factoryClass="com.example.notes.ui.NotesToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="Notes.Prev"
                class="com.example.notes.actions.PrevNoteAction"
                text="Previous Note"
                description="Go to the previous note"
                icon="AllIcons.Actions.Back">
            <keyboard-shortcut keymap="$default" first-keystroke="alt LEFT"/>
        </action>

        <action id="Notes.Next"
                class="com.example.notes.actions.NextNoteAction"
                text="Next Note"
                description="Go to the next note"
                icon="AllIcons.Actions.Forward">
            <keyboard-shortcut keymap="$default" first-keystroke="alt RIGHT"/>
        </action>

        <action id="Notes.New"
                class="com.example.notes.actions.NewNoteAction"
                text="New Note"
                description="Create a new note"
                icon="AllIcons.General.Add">
            <keyboard-shortcut keymap="$default" first-keystroke="alt N"/>
        </action>

        <action id="Notes.Delete"
                class="com.example.notes.actions.DeleteNoteAction"
                text="Delete Note"
                description="Delete the current note"
                icon="AllIcons.General.Remove">
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift D"/>
        </action>

        <action id="Notes.Search"
                class="com.example.notes.actions.SearchNotesAction"
                text="Search Notes"
                description="Search notes by title or content"
                icon="AllIcons.Actions.Search">
            <keyboard-shortcut keymap="$default" first-keystroke="alt F"/>
        </action>

        <action id="Notes.List"
                class="com.example.notes.actions.ListNotesAction"
                text="Back to List"
                description="Show the list of all notes"
                icon="AllIcons.Actions.ListFiles">
            <keyboard-shortcut keymap="$default" first-keystroke="alt L"/>
        </action>

        <action id="Notes.More"
                class="com.example.notes.actions.MoreNotesAction"
                text="More Options"
                description="Pin, star, color, sort, import and export"
                icon="AllIcons.Actions.More"/>

        <!-- Toolbar shown in the detail (editor) view. -->
        <group id="Notes.DetailToolbar">
            <reference ref="Notes.List"/>
            <separator/>
            <reference ref="Notes.Prev"/>
            <reference ref="Notes.Next"/>
            <separator/>
            <reference ref="Notes.New"/>
            <reference ref="Notes.Delete"/>
            <separator/>
            <reference ref="Notes.Search"/>
            <reference ref="Notes.More"/>
        </group>

        <!-- Toolbar shown in the list view. -->
        <group id="Notes.ListToolbar">
            <reference ref="Notes.New"/>
            <reference ref="Notes.Delete"/>
            <separator/>
            <reference ref="Notes.More"/>
        </group>
    </actions>
</idea-plugin>
